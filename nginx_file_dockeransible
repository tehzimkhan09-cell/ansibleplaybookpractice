---
- name: downloading docker images
  hosts: all
  become: yes
  gather_facts: false
  tasks:
    - name: pull docker images
      ansible.builtin.docker_image:
        name: nginx
        source: pull

    - name: nginx container ceaertion
      ansible.builtin.docker_container:
        name: mynginx
        image: nginx
        ports:
          - "80:80"
...
