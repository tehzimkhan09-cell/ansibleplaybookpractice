---
# Tags (Playbook ke specific tasks ko select karke chalane ya skip karne ke liye)
---
- name: Tags Example Playbook
  hosts: all
  become: true
  tasks:
    - name: Packages install karein
      ansible.builtin.package:
        name: nginx
        state: present
      tags:
        - setup
        - packages

    - name: Nginx service start karein
      ansible.builtin.service:
        name: nginx
        state: started
      tags:
        - service

    - name: Configuration file copy karein
      ansible.builtin.copy:
        src: ./nginx.conf
        dest: /etc/nginx/nginx.conf
      tags:
        - config
...
